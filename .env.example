# Copy to .env.production or .env.staging; never commit the edited file.
# Use production: 8080/8000 or staging: 8081/8001 with distinct project names.
APP_ENV=production
FRONTEND_PORT=8080
BACKEND_PORT=8000
IMAGE_TAG=local
# Use a fresh random hexadecimal password (URL-safe) for each environment.
POSTGRES_DB=todos
POSTGRES_USER=todoapp
POSTGRES_PASSWORD=
# Random session-signing key; generated by init-env.py. Keep it stable between releases.
SECRET_KEY=
# Set true only when the portal is served over HTTPS.
COOKIE_SECURE=false
# Monitoring credentials must also be filled before starting monitoring.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
CADVISOR_PORT=8082
# Jenkins bootstrap values; socket group ID comes from stat on a Linux host.
JENKINS_PORT=8088
DOCKER_GID=0
